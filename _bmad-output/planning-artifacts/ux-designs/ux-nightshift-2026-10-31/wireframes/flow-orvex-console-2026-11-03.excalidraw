      "isDeleted": false,
      "boundElements": [],
      "updated": 1793404800000,
      "link": null,
      "locked": false,
      "index": "b80",
      "text": "Only a given approval expires; an\nunanswered request stays open with\ncurrent evidence, is re-issued on a\nmaterial change, withdrawn if the problem\nresolves. Validity is set per repair in\nthe catalogue (number:\nOrvex/architecture). (Amine, 2026-11-03)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Only a given approval expires; an\nunanswered request stays open with\ncurrent evidence, is re-issued on a\nmaterial change, withdrawn if the problem\nresolves. Validity is set per repair in\nthe catalogue (number:\nOrvex/architecture). (Amine, 2026-11-03)",
      "lineHeight": 1.25,
      "autoResize": true
    },
