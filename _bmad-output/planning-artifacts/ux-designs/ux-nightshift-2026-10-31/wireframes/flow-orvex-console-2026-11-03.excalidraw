      "updated": 1793404800000,
      "link": null,
      "locked": false,
      "index": "b84",
      "text": "Only clusters with the same problem, in the same problem group. Josh's\napproval is recorded per cluster; it never replaces a customer's\nrequired permission or a cluster's own safety checks. (Amine)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Only clusters with the same problem, in the same problem group. Josh's\napproval is recorded per cluster; it never replaces a customer's\nrequired permission or a cluster's own safety checks. (Amine)",
      "lineHeight": 1.25,
      "autoResize": true
    },
