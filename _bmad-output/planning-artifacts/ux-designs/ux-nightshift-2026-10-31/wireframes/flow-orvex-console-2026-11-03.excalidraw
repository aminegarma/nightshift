      "link": null,
      "locked": false,
      "index": "b2q",
      "text": "The memory growth looks like a slow leak in checkout-api. Restarting\nthe replica usually frees the memory. Because there is only one\nreplica, checkout is briefly unavailable during the restart.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
