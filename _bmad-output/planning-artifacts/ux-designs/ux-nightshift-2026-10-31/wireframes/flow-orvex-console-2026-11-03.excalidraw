      "link": null,
      "locked": false,
      "index": "b82",
      "text": "One repair per approval; never bundled.\nSame order as the customer approval (B3),\nplus technical depth.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "One repair per approval; never bundled.\nSame order as the customer approval (B3),\nplus technical depth.",
      "lineHeight": 1.25,
      "autoResize": true
    },
