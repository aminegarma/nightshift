      "boundElements": [],
      "updated": 1793404800000,
      "link": null,
      "locked": false,
      "index": "b7u",
      "text": "Queue before grid: the engineer acts on problems,\nnot on clusters. Stale panels go grey with words,\nnever a stale green. (FR-4, FR-6; Amine)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Queue before grid: the engineer acts on problems,\nnot on clusters. Stale panels go grey with words,\nnever a stale green. (FR-4, FR-6; Amine)",
      "lineHeight": 1.25,
      "autoResize": true
    },
