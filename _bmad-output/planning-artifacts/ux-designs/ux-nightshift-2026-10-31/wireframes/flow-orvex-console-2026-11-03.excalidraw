      "link": null,
      "locked": false,
      "index": "b7w",
      "text": "Dangerous repairs are manual in v1 and\nuse A3-M, not this screen (FR-52).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Dangerous repairs are manual in v1 and\nuse A3-M, not this screen (FR-52).",
