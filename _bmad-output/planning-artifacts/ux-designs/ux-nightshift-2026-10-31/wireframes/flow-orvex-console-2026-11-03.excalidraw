      "link": null,
      "locked": false,
      "index": "b7s",
      "text": "Variant — Signed in: Orvex support (restricted role).\nSame console. Can approve on a customer's behalf only\nwhere delegated; never for manual dangerous repairs,\nwhich the customer approves personally (FR-52).\n(FR-21; Amine)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Variant — Signed in: Orvex support (restricted role).\nSame console. Can approve on a customer's behalf only\nwhere delegated; never for manual dangerous repairs,\nwhich the customer approves personally (FR-52).\n(FR-21; Amine)",
      "lineHeight": 1.25,
      "autoResize": true
    },
