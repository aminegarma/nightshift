      "link": null,
      "locked": false,
      "index": "b7P",
      "text": "Dangerous repairs: the customer must\napprove personally — Orvex support cannot\napprove on their behalf — and a reviewed\nrecovery plan is required. (FR-21; Amine)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Dangerous repairs: the customer must\napprove personally — Orvex support cannot\napprove on their behalf — and a reviewed\nrecovery plan is required. (FR-21; Amine)",
      "lineHeight": 1.25,
      "autoResize": true
    },
