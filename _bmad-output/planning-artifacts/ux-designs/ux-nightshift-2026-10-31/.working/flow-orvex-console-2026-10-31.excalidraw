      "updated": 1793404800000,
      "link": null,
      "locked": false,
      "index": "b2e",
      "text": "The memory growth looks like a slow leak in checkout-api. Restarting\nthe replica usually frees the memory. Because there is only one\nreplica, checkout is briefly unavailable during the restart.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "The memory growth looks like a slow leak in checkout-api. Restarting\nthe replica usually frees the memory. Because there is only one\nreplica, checkout is briefly unavailable during the restart.",
      "lineHeight": 1.25,
      "autoResize": true
    },
