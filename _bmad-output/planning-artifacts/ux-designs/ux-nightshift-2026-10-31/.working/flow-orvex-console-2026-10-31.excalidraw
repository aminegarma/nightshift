      "link": null,
      "locked": false,
      "index": "b7R",
      "text": "Reject: blocks this repair, records the\ndecision, notifies the relevant\napprovers; Nightshift keeps monitoring.\nNo automatic resubmission, no substitute\nrepair. Other automatic repairs stay on;\nthe confirmation says so. (Amine)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Reject: blocks this repair, records the\ndecision, notifies the relevant\napprovers; Nightshift keeps monitoring.\nNo automatic resubmission, no substitute\nrepair. Other automatic repairs stay on;\nthe confirmation says so. (Amine)",
      "lineHeight": 1.25,
      "autoResize": true
    },
